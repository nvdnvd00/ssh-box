{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Box",
  "version": "../package.json",
  "identifier": "com.neos.sshbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "SSH Box",
        "width": 1360,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Neos Nguyen",
    "copyright": "Copyright © 2026 Neos Nguyen. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "Modern SSH Client, Terminal & Server Manager",
    "longDescription": "All-in-one SSH client, terminal, dual-pane SFTP manager, live server monitor, and visual server configuration studio.",
    "homepage": "https://github.com/nvdnvd00/ssh-box",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyNENDQkFEODAyQjEzRUQKUldUdEV5dUFyY3RNa21vc3p4NVFBME9SYlI0V1FWdm9DT1Z5MFVLMlBlOWtGMk1XSWhYRmM5Z3gK",
      "requireSignedVersion": true
    }
  }
}
